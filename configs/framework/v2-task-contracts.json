    "target_tracking": {
      "contract_id": "V2-TARGET-ENUMERATION",
      "allowed_finding_types": ["extracted_fact"],
      "required_fields": ["metric"],
      "allowed_statuses": ["verified", "partially_verified", "insufficient_information", "extraction_failure"],
      "minimum_items": {"supporting_evidence": 1}
    },
    "abstention": {
