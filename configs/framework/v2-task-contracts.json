      "required_fields": ["metric"],
      "allowed_statuses": ["verified", "partially_verified", "insufficient_information", "extraction_failure"],
      "minimum_items": {"supporting_evidence": 1}
    },
    "deterministic_calculation": {
      "contract_id": "V2-CALCULATION",
      "allowed_finding_types": ["calculated_fact"],
      "required_fields": ["metric", "calculation", "rule_checks"],
      "allowed_statuses": ["verified", "partially_verified"],
      "minimum_items": {"supporting_evidence": 1, "rule_checks": 1}
