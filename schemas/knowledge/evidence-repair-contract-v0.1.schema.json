{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Evidence repair contract v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_id", "causal_subtypes", "risk_level", "execution_policy", "required_inputs", "validation_gates", "derived_output", "candidate_output_rewrite_allowed", "rollback"],
  "properties": {
    "contract_id": {"type": "string", "pattern": "^ERC-[A-Z0-9-]+-V01$"},
    "causal_subtypes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "risk_level": {"enum": ["low", "medium", "high"]},
    "execution_policy": {"enum": ["supervised", "supervised_new_lineage", "blocked"]},
    "required_inputs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "validation_gates": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "derived_output": {"type": "string", "minLength": 1},
    "candidate_output_rewrite_allowed": {"const": false},
    "rollback": {"type": "string", "minLength": 1}
  }
}
