{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "scale-ingestion-batch-v0.1.schema.json",
  "title": "Scale ingestion batch",
  "type": "object",
  "required": ["schema_version", "batch_id", "status", "policy", "documents"],
  "properties": {
    "schema_version": {"const": "0.1"},
    "batch_id": {"type": "string", "minLength": 1},
    "status": {"enum": ["source_locked", "acquiring", "acquired", "diagnosed", "complete"]},
    "policy": {
      "type": "object",
      "required": ["local_only", "cloud_transmission", "locked_experiments_untouched"],
      "properties": {
        "local_only": {"const": true},
        "cloud_transmission": {"const": false},
        "locked_experiments_untouched": {
          "type": "array",
          "contains": {"const": "P3-P23"}
        }
      },
      "additionalProperties": true
    },
    "documents": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "document_id", "source_group_id", "company", "title", "report_year",
          "official_landing_page", "download_url", "official_domain", "local_path",
          "source_role", "language", "prior_experiment_use"
        ],
        "properties": {
          "document_id": {"type": "string", "minLength": 1},
          "source_group_id": {"type": "string", "minLength": 1},
          "company": {"type": "string", "minLength": 1},
          "title": {"type": "string", "minLength": 1},
          "report_year": {"type": "integer", "minimum": 2000},
          "official_landing_page": {"type": "string", "format": "uri"},
          "download_url": {"type": "string", "format": "uri"},
          "official_domain": {"type": "string", "minLength": 1},
          "local_path": {"type": "string", "pattern": "^data/raw/scale_batch_"},
          "source_role": {"enum": ["primary_report", "data_annex", "assurance_report"]},
          "language": {"const": "English"},
          "prior_experiment_use": {"const": false}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
