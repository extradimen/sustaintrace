{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/esg/metric-component-boundary-validation-v0.1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "record_kind", "validation_id", "case_id", "fact_record_id", "task_id", "predicate", "value", "table_coordinate", "checks", "validation_status", "execution_performed", "promotion_performed", "rollback"],
  "properties": {
    "schema_version": {"const": "0.1"},
    "record_kind": {"const": "metric_component_boundary_validation"},
    "validation_id": {"type": "string", "pattern": "^metric-validation-[0-9a-f]{24}$"},
    "case_id": {"type": "string", "pattern": "^boundary-case-[0-9a-f]{24}$"},
    "fact_record_id": {"type": "string", "pattern": "^fact-[0-9a-f]{24}$"},
    "task_id": {"type": "string", "minLength": 1},
    "predicate": {"type": "string", "minLength": 1},
    "value": {},
    "table_coordinate": {
      "type": "object", "additionalProperties": false,
      "required": ["graph_id", "page", "row", "column", "component_role", "method_role", "footnote"],
      "properties": {
        "graph_id": {"type": "string", "minLength": 1},
        "page": {"type": "integer", "minimum": 1},
        "row": {"type": "string", "minLength": 1},
        "column": {"type": "string", "minLength": 1},
        "component_role": {"enum": ["component", "total"]},
        "method_role": {"type": "string"},
        "footnote": {"type": ["string", "null"]}
      }
    },
    "checks": {"type": "object", "additionalProperties": {"type": "boolean"}, "minProperties": 12},
    "validation_status": {"enum": ["ready_for_supervised_execution", "not_ready"]},
    "execution_performed": {"const": false},
    "promotion_performed": {"const": false},
    "rollback": {"const": "delete_validation_and_preserve_unresolved_candidate"}
  }
}
