{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/esg/tier-b-blocker-resolution-v0.1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "record_kind", "resolution_id", "fact_record_id", "task_id",
    "resolved_signature", "resolution_type", "resolved_value", "evidence",
    "effective_blockers", "effective_status", "execution_mode", "rollback",
    "source_fact_modified", "promotion_performed"
  ],
  "properties": {
    "schema_version": {"const": "0.1"},
    "record_kind": {"const": "tier_b_blocker_resolution"},
    "resolution_id": {"type": "string", "pattern": "^resolution-[0-9a-f]{24}$"},
    "fact_record_id": {"type": "string", "pattern": "^fact-[0-9a-f]{24}$"},
    "task_id": {"type": "string", "minLength": 1},
    "resolved_signature": {"const": "PERIOD_ATTACHMENT_INCOMPLETE"},
    "resolution_type": {"enum": ["exact_source_label", "not_applicable_non_temporal_field"]},
    "resolved_value": {"type": ["string", "null"]},
    "evidence": {"type": "string", "minLength": 1},
    "effective_blockers": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "effective_status": {
      "enum": ["ready_for_independent_source_review", "blocked_additional_qualification"]
    },
    "execution_mode": {"const": "derived_layer_only"},
    "rollback": {"const": "delete_derived_resolution_record"},
    "source_fact_modified": {"const": false},
    "promotion_performed": {"const": false}
  }
}
