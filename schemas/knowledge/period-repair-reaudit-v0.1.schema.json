{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/esg-reliable-discovery/period-repair-reaudit-v0.1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "record_kind", "fact_record_id", "attachment_id", "period_before", "period_after", "remaining_gap_count", "qualification_after", "promotion_performed"],
  "properties": {
    "schema_version": {"const": "0.1"},
    "record_kind": {"const": "period_repair_reaudit"},
    "fact_record_id": {"type": "string", "pattern": "^fact-[0-9a-f]{24}$"},
    "attachment_id": {"type": "string", "pattern": "^period-[0-9a-f]{24}$"},
    "period_before": {"type": "string"},
    "period_after": {"const": "exact_frozen_cell_header"},
    "remaining_gap_count": {"type": "integer", "minimum": 0},
    "qualification_after": {"enum": ["jointly_qualified_candidate", "incomplete_qualification"]},
    "promotion_performed": {"const": false}
  }
}
