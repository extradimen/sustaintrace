{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sustaintrace.org/schemas/relation-edge-v0.1.schema.json",
  "title": "SustainTrace trusted entity-fact edge",
  "type": "object",
  "required": ["schema_version", "record_kind", "edge_id", "subject_entity_id", "predicate", "object", "source_fact_id", "trust_tier", "evidence"],
  "properties": {
    "schema_version": {"const": "0.1"},
    "record_kind": {"const": "entity_fact_edge"},
    "edge_id": {"type": "string", "pattern": "^edge-[a-f0-9]{20}$"},
    "subject_entity_id": {"type": "string", "pattern": "^issuer-[a-f0-9]{20}$"},
    "predicate": {"type": "string", "minLength": 1},
    "object": {"type": "object", "required": ["kind", "value"], "properties": {"kind": {"const": "literal"}, "value": {}}, "additionalProperties": false},
    "qualifiers": {"type": "object"},
    "reported_subject_label": {"type": "string"},
    "source_fact_id": {"type": "string"},
    "trust_tier": {"const": "B"},
    "evidence": {"type": "array", "minItems": 1}
  },
  "additionalProperties": false
}
