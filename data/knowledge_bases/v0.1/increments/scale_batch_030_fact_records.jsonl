{"evidence":[{"pdf_page":91,"quote":"By monitoring the employee dialogues that have been archived in the Learning platform, NCC tracks the proportion of white-collar employees who participated in employee dialogues in 2025. This gives an indication of completion rates, even if the actual proportion is higher. One of NCC\u2019s focus areas in 2026 is increasing the proportion of employee dialogues stored in the Learning platform.","source_id":"KB-B030-NCC-ASR2025"}],"knowledge_status":"reference_candidate","predicate":{"canonical_key":"evidence_snippet_workforce","raw_key":"workforce"},"promotion":{"eligible":false,"reason":"requires_atomic_projection_and_independent_evidence_gate"},"provenance":{"reference_status":"mineru_exact_quote_pending_semantic_projection","simulated":false,"source_artifact":"artifacts/scale_batch_030/mineru_targets_RESUME01/KB-B030-NCC-ASR2025-p0091/ncc-annual-and-sustainability-report-2025/auto/ncc-annual-and-sustainability-report-2025.md","source_sha256":"0a2ea91f7110d332c14ebcb1df414565233ceb39a0c68b48466144999678de0e"},"qualifiers":{"answer_status":"unverified_evidence_candidate","calculation_expression":null,"normalized_unit":null,"period_literal":"2025","reference_period":2025,"scope_boundary":null,"value_origin":"issuer_disclosure_extracted"},"record_id":"fact-2611254b163b902f755e3bfd","record_kind":"fact","schema_version":"0.1","subject":{"document_ids":["KB-B030-NCC-ASR2025"],"document_metadata":[{"company":"NCC AB (publ)","document_id":"KB-B030-NCC-ASR2025","language":"English","local_path":"data/raw/scale_batch_030/ncc-annual-and-sustainability-report-2025.pdf","sha256":"253f5b9bf6a12ec5ce7e1965711dcda91af42da1bd58cb37972b5d87af853de2","title":"NCC Annual and Sustainability Report 2025"}],"entity_label":"NCC AB (publ)","task_id":"KB-B028-KB-B030-NCC-ASR2025-P0091-WORKFORCE-2"},"trust_tier":"C","value":"By monitoring the employee dialogues that have been archived in the Learning platform, NCC tracks the proportion of white-collar employees who participated in employee dialogues in 2025. This gives an indication of completion rates, even if the actual proportion is higher. One of NCC\u2019s focus areas in 2026 is increasing the proportion of employee dialogues stored in the Learning platform."}
