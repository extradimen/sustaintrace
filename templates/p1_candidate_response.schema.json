{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/esg-reliable-discovery/p1_candidate_response.schema.json",
  "title": "P1 Candidate Answer",
  "type": "object",
  "required": ["task_id", "answer_status", "answer", "normalized_value", "normalized_unit", "subject", "scope_boundary", "period", "calculation", "evidence"],
  "properties": {
    "task_id": {"type": "string", "pattern": "^P1-[0-9]{2}-[12]$"},
    "answer_status": {"enum": ["verified_fact", "insufficient_information", "conflict"]},
    "answer": {"type": ["string", "number", "array", "object", "null"]},
    "normalized_value": {"type": ["string", "number", "null"]},
    "normalized_unit": {"type": ["string", "null"]},
    "subject": {"type": ["string", "null"]},
    "scope_boundary": {"type": ["string", "null"]},
    "period": {"type": ["string", "null"]},
    "calculation": {
      "type": ["object", "null"],
      "properties": {
        "expression": {"type": "string"},
        "inputs": {"type": "array", "items": {"type": "number"}},
        "result": {"type": "number"}
      },
      "required": ["expression", "inputs", "result"],
      "additionalProperties": false
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["source_id", "page", "verbatim_excerpt", "role"],
        "properties": {
          "source_id": {"type": "string"},
          "page": {"type": "integer", "minimum": 1},
          "verbatim_excerpt": {"type": "string", "minLength": 1},
          "role": {"enum": ["claim_support", "calculation_input", "conflict_source"]}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
