{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/esg-reliable-discovery/finding-card-v1.schema.json",
  "title": "ESG Reliable Discovery Finding Card v1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "finding_id",
    "task_id",
    "finding_type",
    "claim_level",
    "anomaly_codes",
    "claim",
    "company_id",
    "company",
    "periods",
    "supporting_evidence",
    "contrary_evidence",
    "search_scope",
    "alternative_explanations",
    "confidence",
    "confidence_basis",
    "status",
    "requires_human_review",
    "falsification_condition",
    "provenance"
  ],
  "properties": {
    "finding_id": {"type": "string", "minLength": 1},
    "task_id": {"type": "string", "minLength": 1},
    "finding_type": {
      "enum": ["extracted_fact", "calculated_fact", "structural_anomaly", "association_pattern", "candidate_explanation"]
    },
    "claim_level": {"enum": ["L1", "L2", "L3", "L4", "L5"]},
    "anomaly_codes": {
      "type": "array",
      "items": {"enum": ["A01", "A02", "A03", "A04", "A05", "A06", "A07", "A08", "A09", "A10", "A11", "A12"]},
      "uniqueItems": true
    },
    "claim": {"type": "string", "minLength": 1},
    "company_id": {"type": "string", "minLength": 1},
    "company": {"type": "string", "minLength": 1},
    "periods": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1, "uniqueItems": true},
    "metric": {"$ref": "#/$defs/metric"},
    "supporting_evidence": {"type": "array", "items": {"$ref": "#/$defs/evidence"}},
    "contrary_evidence": {"type": "array", "items": {"$ref": "#/$defs/evidence"}},
    "calculation": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/calculation"}]},
    "rule_checks": {"type": "array", "items": {"$ref": "#/$defs/rule_check"}},
    "search_scope": {"$ref": "#/$defs/search_scope"},
    "alternative_explanations": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "confidence_basis": {"type": "string", "minLength": 1},
    "status": {"enum": ["verified", "partially_verified", "contradicted", "insufficient_information", "extraction_failure", "not_applicable"]},
    "requires_human_review": {"type": "boolean"},
    "falsification_condition": {"type": "string", "minLength": 1},
    "provenance": {"$ref": "#/$defs/provenance"}
  },
  "allOf": [
    {
      "if": {"properties": {"finding_type": {"const": "structural_anomaly"}}, "required": ["finding_type"]},
      "then": {"properties": {"anomaly_codes": {"minItems": 1}}}
    },
    {
      "if": {"properties": {"finding_type": {"const": "calculated_fact"}}, "required": ["finding_type"]},
      "then": {"required": ["calculation"], "properties": {"calculation": {"$ref": "#/$defs/calculation"}}}
    },
    {
      "if": {"properties": {"status": {"enum": ["verified", "partially_verified"]}}, "required": ["status"]},
      "then": {"properties": {"supporting_evidence": {"minItems": 1}}}
    }
  ],
  "$defs": {
    "metric": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "reported_value", "unit", "subject", "boundary", "period"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "reported_value": {"type": ["number", "string", "null"]},
        "unit": {"type": ["string", "null"]},
        "subject": {"type": "string", "minLength": 1},
        "boundary": {"type": ["string", "null"]},
        "period": {"type": "string", "minLength": 1}
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["document_id", "document_sha256", "page", "location", "excerpt", "evidence_strength"],
      "properties": {
        "document_id": {"type": "string", "minLength": 1},
        "document_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "page": {"type": "integer", "minimum": 1},
        "printed_page": {"type": ["string", "null"]},
        "location": {"type": "string", "minLength": 1},
        "excerpt": {"type": "string", "minLength": 1, "maxLength": 500},
        "evidence_strength": {"enum": ["direct", "indirect", "context"]},
        "transformation": {"type": ["string", "null"]}
      }
    },
    "calculation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["formula", "inputs", "result", "unit"],
      "properties": {
        "formula": {"type": "string", "minLength": 1},
        "inputs": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1},
        "result": {"type": ["number", "string"]},
        "unit": {"type": ["string", "null"]}
      }
    },
    "rule_check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rule_id", "result", "details"],
      "properties": {
        "rule_id": {"type": "string", "minLength": 1},
        "result": {"enum": ["pass", "fail", "not_applicable", "unknown"]},
        "details": {"type": ["string", "null"]}
      }
    },
    "search_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["checked_elements", "completeness", "limitations"],
      "properties": {
        "checked_elements": {
          "type": "array",
          "items": {"enum": ["report_body", "tables", "figures", "index", "appendix", "annual_report", "external_source"]},
          "uniqueItems": true
        },
        "completeness": {"enum": ["complete", "partial", "not_applicable"]},
        "limitations": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["annotation_source", "framework_version", "model_snapshot", "prompt_sha256", "run_id", "created_at"],
      "properties": {
        "annotation_source": {"enum": ["model", "human", "hybrid"]},
        "framework_version": {"type": "string", "minLength": 1},
        "model_snapshot": {"type": ["string", "null"]},
        "prompt_sha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
        "run_id": {"type": "string", "minLength": 1},
        "created_at": {"type": "string", "format": "date-time"}
      }
    }
  }
}
