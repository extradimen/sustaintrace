{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/esg-reliable-discovery/p1_synthetic_reference.schema.json",
  "title": "P1 AI-Simulated Expert Reference",
  "type": "object",
  "required": [
    "schema_version", "task_id", "reference_author", "reference_status", "question",
    "answer_status", "evidence", "search_record", "provenance_attestation"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "task_id": {"type": "string", "pattern": "^P1-[0-9]{2}-[12]$"},
    "reference_author": {"const": "codex_gpt_simulated_expert"},
    "reference_status": {"enum": ["draft", "verified"]},
    "question": {"type": "string", "minLength": 10},
    "answer_status": {"enum": ["verified_fact", "insufficient_information", "conflict"]},
    "answer": {"type": ["string", "number", "array", "object", "null"]},
    "normalized_value": {"type": ["string", "number", "null"]},
    "normalized_unit": {"type": ["string", "null"]},
    "reported_unit": {"type": ["string", "null"]},
    "subject": {"type": ["string", "null"]},
    "scope_boundary": {"type": ["string", "null"]},
    "period": {"type": ["string", "null"]},
    "calculation": {"type": ["object", "null"]},
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["document_id", "document_sha256", "pdf_page", "verbatim_excerpt", "role"],
        "properties": {
          "document_id": {"type": "string"},
          "document_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "pdf_page": {"type": "integer", "minimum": 1},
          "printed_page": {"type": ["string", "null"]},
          "verbatim_excerpt": {"type": "string", "minLength": 1},
          "role": {"enum": ["claim_support", "calculation_input", "conflict_source"]}
        },
        "additionalProperties": false
      }
    },
    "search_record": {
      "type": "object",
      "required": ["pages_reviewed", "terms_used"],
      "properties": {
        "pages_reviewed": {"type": "array", "items": {"type": "integer", "minimum": 1}},
        "terms_used": {"type": "array", "items": {"type": "string"}},
        "notes": {"type": "string"}
      },
      "additionalProperties": false
    },
    "controlled_intervention_id": {"type": ["string", "null"]},
    "provenance_attestation": {
      "type": "object",
      "required": ["is_human", "is_ai_simulation", "candidate_model_excluded"],
      "properties": {
        "is_human": {"const": false},
        "is_ai_simulation": {"const": true},
        "candidate_model_excluded": {"const": true}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
